{
  "version": "0.7",
  "positive": [
    {
      "code": "def twice x = x * 2 ; twice 5 ;",
      "expected": [
        10
      ],
      "stdlib": false
    },
    {
      "code": "def square x = x * x ; square 7 ;",
      "expected": [
        49
      ],
      "stdlib": false
    },
    {
      "code": "def add a b = a + b ; def add3 = add 3 ; add3 8 ;",
      "expected": [
        11
      ],
      "stdlib": false
    },
    {
      "code": "def makeAdder x = fun y -> x + y ; makeAdder 10 8 ;",
      "expected": [
        18
      ],
      "stdlib": false
    },
    {
      "code": "def fact n = if n < 2 then 1 else n * fact ( n - 1 ) ; fact 5 ;",
      "expected": [
        120
      ],
      "stdlib": false
    },
    {
      "code": "def compose f g x = f ( g x ) ; def inc x = x + 1 ; compose inc inc 5 ;",
      "expected": [
        7
      ],
      "stdlib": false
    },
    {
      "code": "if true then 7 else 0 ; if false then 0 else 9 ;",
      "expected": [
        7,
        9
      ],
      "stdlib": false
    },
    {
      "code": "def choose x = if x > 0 then x else 0 ; choose -4 ;",
      "expected": [
        0
      ],
      "stdlib": false
    },
    {
      "code": "def f x = x + 2 * 3 ; f 1 ;",
      "expected": [
        7
      ],
      "stdlib": false
    },
    {
      "code": "[ 1 , 2 , 3 ] ; [] ; [ ] ;",
      "expected": [
        [
          1,
          2,
          3
        ],
        [],
        []
      ],
      "stdlib": false
    },
    {
      "code": "cons 1 [ 2 , 3 ] ; head [ 4 , 5 ] ; tail [ 4 , 5 ] ; isEmpty [] ;",
      "expected": [
        [
          1,
          2,
          3
        ],
        4,
        [
          5
        ],
        true
      ],
      "stdlib": false
    },
    {
      "code": "[ 1 , 2 ] == [ 1 , 2 ] ; [ 1 ] != [ 2 ] ;",
      "expected": [
        true,
        true
      ],
      "stdlib": false
    },
    {
      "code": "def add a b = a + b ; def inc = add 1 ; inc 41 ;",
      "expected": [
        42
      ],
      "stdlib": false
    },
    {
      "code": "def f x = x + 2 ; def g x = f x * 3 ; g 4 ;",
      "expected": [
        18
      ],
      "stdlib": false
    },
    {
      "code": "def f x = fun y -> x + y ; def a = f 2 ; a 3 ;",
      "expected": [
        5
      ],
      "stdlib": false
    },
    {
      "code": "def twice x = x * 2 ; map twice [ 1 , 2 , 3 ] ;",
      "expected": [
        [
          2,
          4,
          6
        ]
      ],
      "stdlib": true
    },
    {
      "code": "filter ( fun x -> x > 2 ) [ 1 , 2 , 3 , 4 ] ;",
      "expected": [
        [
          3,
          4
        ]
      ],
      "stdlib": true
    },
    {
      "code": "fold ( fun acc x -> acc + x ) 0 [ 1 , 2 , 3 ] ;",
      "expected": [
        6
      ],
      "stdlib": true
    },
    {
      "code": "reverse [ 1 , 2 , 3 ] ;",
      "expected": [
        [
          3,
          2,
          1
        ]
      ],
      "stdlib": true
    },
    {
      "code": "length [ 1 , 2 , 3 , 4 ] ;",
      "expected": [
        4
      ],
      "stdlib": true
    },
    {
      "code": "map ( fun x -> x * x ) [] ;",
      "expected": [
        []
      ],
      "stdlib": true
    },
    {
      "code": "def twice x = x * 2 ; map twice ( filter ( fun x -> x > 2 ) [ 1 , 2 , 3 , 4 ] ) ;",
      "expected": [
        [
          6,
          8
        ]
      ],
      "stdlib": true
    },
    {
      "code": "def f cons = [ 1 , 2 ] ; f 99 ;",
      "expected": [
        [
          1,
          2
        ]
      ],
      "stdlib": false
    },
    {
      "code": "if true then 2 else 1 / 0 ;",
      "expected": [
        2
      ],
      "stdlib": false
    },
    {
      "code": "let x = 21 in x * 2 ;",
      "expected": [
        42
      ],
      "stdlib": false
    },
    {
      "code": "let x = 2 in let x = x + 3 in x * 4 ;",
      "expected": [
        20
      ],
      "stdlib": false
    },
    {
      "code": "def addX x = let y = 3 in x + y ; addX 7 ;",
      "expected": [
        10
      ],
      "stdlib": false
    },
    {
      "code": "let xs = [ 1 , 2 ] in match xs with | [] -> 0 | h :: t -> h ;",
      "expected": [
        1
      ],
      "stdlib": false
    },
    {
      "code": "match [] with | [] -> 7 | h :: t -> h ;",
      "expected": [
        7
      ],
      "stdlib": false
    },
    {
      "code": "match [ 3 , 4 ] with | h :: t -> h + head t | [] -> 0 ;",
      "expected": [
        7
      ],
      "stdlib": false
    },
    {
      "code": "def sum xs = match xs with | [] -> 0 | x :: rest -> x + sum rest ; sum [ 1 , 2 , 3 , 4 ] ;",
      "expected": [
        10
      ],
      "stdlib": false
    },
    {
      "code": "def length2 xs = match xs with | [] -> 0 | _ :: rest -> 1 + length2 rest ; length2 [ 3 , 4 , 5 ] ;",
      "expected": [
        3
      ],
      "stdlib": false
    },
    {
      "code": "match [ 42 ] with | [] -> false | _ :: _ -> true ;",
      "expected": [
        true
      ],
      "stdlib": false
    },
    {
      "code": "let head = fun xs -> 999 in let isEmpty = fun xs -> true in match [ 8 ] with | [] -> 0 | x :: rest -> x ;",
      "expected": [
        8
      ],
      "stdlib": false
    },
    {
      "code": "match [ 4 , 5 ] with | [ ] -> 0 | x :: rest -> x ;",
      "expected": [
        4
      ],
      "stdlib": false
    },
    {
      "code": "def firstOr zero xs = match xs with | [] -> zero | a :: _ -> a ; firstOr 9 [] ; firstOr 9 [ 3 ] ;",
      "expected": [
        9,
        3
      ],
      "stdlib": false
    },
    {
      "code": "let id = fun x -> x in let n = id 1 in id true ;",
      "expected": [
        true
      ],
      "stdlib": false
    },
    {
      "code": "map ( fun x -> let y = x * x in y + 1 ) [ 1 , 2 , 3 ] ;",
      "expected": [
        [
          2,
          5,
          10
        ]
      ],
      "stdlib": true
    },
    {
      "code": "filter ( fun x -> x > 2 ) [ 1 , 2 , 3 , 4 ] ;",
      "expected": [
        [
          3,
          4
        ]
      ],
      "stdlib": true
    },
    {
      "code": "fold ( fun sum x -> sum + x ) 0 [ 1 , 2 , 3 , 4 ] ;",
      "expected": [
        10
      ],
      "stdlib": true
    },
    {
      "code": "length ( reverse [ 1 , 2 , 3 ] ) ;",
      "expected": [
        3
      ],
      "stdlib": true
    },
    {
      "code": "map ( fun xs -> match xs with | [] -> 0 | n :: _ -> n ) [ [] , [ 1 ] , [ 2 ] ] ;",
      "expected": [
        [
          0,
          1,
          2
        ]
      ],
      "stdlib": true
    },
    {
      "code": "\" hello world \" ;",
      "expected": [
        "hello world"
      ],
      "stdlib": false
    },
    {
      "code": "\" \" ;",
      "expected": [
        ""
      ],
      "stdlib": false
    },
    {
      "code": "\" a # b \" ;",
      "expected": [
        "a # b"
      ],
      "stdlib": false
    },
    {
      "code": "textLength \" hello \" ; textAt \" hello \" 1 ; textConcat \" ab \" \" cd \" ;",
      "expected": [
        5,
        "e",
        "abcd"
      ],
      "stdlib": false
    },
    {
      "code": "\" a \" == \" a \" ; \" a \" != \" b \" ;",
      "expected": [
        true,
        true
      ],
      "stdlib": false
    },
    {
      "code": "textLength \" \\u0020 \" ; textAt \" abc \" 0 ;",
      "expected": [
        1,
        "a"
      ],
      "stdlib": false
    },
    {
      "code": "def greet who = textConcat \" hello \" who ; greet \" earth \" ;",
      "expected": [
        "helloearth"
      ],
      "stdlib": false
    },
    {
      "code": "tokenize \" def twice x = x * 2 ; \" ;",
      "expected": [
        [
          "def",
          "twice",
          "x",
          "=",
          "x",
          "*",
          "2",
          ";"
        ]
      ],
      "stdlib": true
    },
    {
      "code": "tokenize \" \\u0020\\u0020a\\t\\u0020b\\n c \\u0020 \" ;",
      "expected": [
        [
          "a",
          "b",
          "c"
        ]
      ],
      "stdlib": true
    },
    {
      "code": "tokenize \" \" ;",
      "expected": [
        []
      ],
      "stdlib": true
    },
    {
      "code": "parseTinyDef \" def twice x = x * 2 ; \" ;",
      "expected": [
        [
          "Define",
          "twice",
          "x",
          "Multiply",
          "x",
          "2"
        ]
      ],
      "stdlib": true
    },
    {
      "code": "parseTinyDef \" def inc x = x + 1 ; \" ;",
      "expected": [
        [
          "Define",
          "inc",
          "x",
          "Add",
          "x",
          "1"
        ]
      ],
      "stdlib": true
    },
    {
      "code": "parseTinyDef \" def f x = 1 + 2 ; \" ;",
      "expected": [
        []
      ],
      "stdlib": true
    },
    {
      "code": "parseTinyDef \" def broken x = y + 2 ; \" ;",
      "expected": [
        []
      ],
      "stdlib": true
    },
    {
      "code": "def id x = x ; id \" yes \" ;",
      "expected": [
        "yes"
      ],
      "stdlib": false
    }
  ],
  "negative": [
    {
      "code": "def twice = * 2 ;",
      "errorRegex": "Unexpected token"
    },
    {
      "code": "3 |> twice ;",
      "errorRegex": "Expected"
    },
    {
      "code": "s:Ciao%20mondo ;",
      "errorRegex": "Unexpected token"
    },
    {
      "code": "if 1 then 2 else 3 ;",
      "errorRegex": "Expected boolean"
    },
    {
      "code": "1 + true ;",
      "errorRegex": "Expected finite number"
    },
    {
      "code": "1 / 0 ;",
      "errorRegex": "Division by zero"
    },
    {
      "code": "head [] ;",
      "errorRegex": "head of empty list"
    },
    {
      "code": "def x = 1 ; def x = 2 ;",
      "errorRegex": "Already defined"
    },
    {
      "code": "def f x x = x ;",
      "errorRegex": "duplicate definition parameter"
    },
    {
      "code": "unknown ;",
      "errorRegex": "Unknown name"
    },
    {
      "code": "def f x = f x ; f 1 ;",
      "errorRegex": "Execution budget exceeded"
    },
    {
      "code": "1 2 ;",
      "errorRegex": "Value is not a function"
    },
    {
      "code": "let x = 1 x ;",
      "errorRegex": "Expected in"
    },
    {
      "code": "let _ = 1 in 2 ;",
      "errorRegex": "Invalid let binding"
    },
    {
      "code": "let x = x in x ;",
      "errorRegex": "Unknown name"
    },
    {
      "code": "match [ 1 ] with | [] -> 0 ;",
      "errorRegex": "Expected \\|"
    },
    {
      "code": "match [] with | [] -> 0 | [] -> 1 ;",
      "errorRegex": "Duplicate empty-list pattern"
    },
    {
      "code": "match [ 1 ] with | x :: x -> x | [] -> 0 ;",
      "errorRegex": "Duplicate list pattern binding"
    },
    {
      "code": "match [ 1 ] with | x :: y -> 1 | z :: rest -> 2 ;",
      "errorRegex": "Duplicate cons-list pattern"
    },
    {
      "code": "match [ 1 ] with | _ -> 1 | x :: xs -> 2 ;",
      "errorRegex": "Expected \\:\\:"
    },
    {
      "code": "match [ 1 ] with | [] -> 0 | x :: xs -> x | [] -> 3 ;",
      "errorRegex": "Expected"
    },
    {
      "code": "let x = true in x + 1 ;",
      "errorRegex": "Expected finite number"
    },
    {
      "code": "match true with | [] -> 1 | x :: xs -> 2 ;",
      "errorRegex": "Expected list"
    },
    {
      "code": "textAt \" abc \" 4 ;",
      "errorRegex": "Text index out of range"
    },
    {
      "code": "textAt \" abc \" -1 ;",
      "errorRegex": "Text index out of range"
    },
    {
      "code": "textAt \" abc \" 0.5 ;",
      "errorRegex": "Text index out of range"
    },
    {
      "code": "textLength 5 ;",
      "errorRegex": "Expected text"
    },
    {
      "code": "textConcat \" yes \" 7 ;",
      "errorRegex": "Expected text"
    },
    {
      "code": "\" unterminated ;",
      "errorRegex": "Unterminated string literal"
    },
    {
      "code": "textLength \" \\u00e9 \" ;",
      "errorRegex": "Expected ASCII text"
    }
  ]
}
