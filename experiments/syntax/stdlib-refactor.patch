+def expSecond tree = head ( tail ( syntaxChildren tree ) ) ;
+def expArg label value = syntaxNode " ExpArg " [ syntaxName label , value ] ;
+def expError text = syntaxLeaf " Error " text ;
+def expBad tree = syntaxTag tree == " Error " ;
+def expSpine tree args =
