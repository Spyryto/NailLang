@@ -90,11 +90,13 @@
-def tokenizeAt source i n word reversed =
-  if i == n then
-    reverse ( if word == " " then reversed else cons word reversed )
-  else
-    let ch = textAt source i in
-    if isSpace ch then
-      if word == " " then tokenizeAt source ( i + 1 ) n " " reversed
-      else tokenizeAt source ( i + 1 ) n " " ( cons word reversed )
-    else tokenizeAt source ( i + 1 ) n ( textConcat word ch ) reversed ;
-
-def tokenize source = tokenizeAt source 0 ( textLength source ) " " [] ;
+def tokenize-at source index: i limit: n word reversed =
+  if i == n then
+    reverse ( if word == " " then reversed else cons word reversed )
+  else
+    let ch = textAt source i in
+    if isSpace ch then
+      if word == " " then tokenize-at source ( i + 1 ) n " " reversed
+      else tokenize-at source ( i + 1 ) n " " ( cons word reversed )
+    else tokenize-at source ( i + 1 ) n ( textConcat word ch ) reversed ;
+
+# Retain the original callable name for host callers during the experiment.
+def tokenizeAt = tokenize-at ;
+def tokenize source = tokenize-at source index: 0 limit: ( textLength source ) word: " " reversed: [] ;
@@ -125,1 +127,1 @@
