import haxe.Json;
import nail.Ast.Expr;
import nail.Ast.Form;
import nail.BootRuntime;
import nail.BootstrapImage;
import nail.ByteVm;
import nail.BytecodeCompiler;
import nail.NType;
import nail.Parser;
import nail.ProceduralHygiene;
import nail.ProceduralTransformer;
import nail.SourcePositions;
import nail.SyntaxBridge;
import nail.SyntaxEncoder;
import nail.TypeChecker;
import nail.Value;
import nail.Vm;

class ProceduralTransformerTestMain {
  static var checks = 0;

  static function ok(yes:Bool, label:String):Void {
    if (!yes) throw 'PROCEDURAL TRANSFORMER: ' + label;
    checks++;
  }

  static function same(a:Value, b:Value, label:String):Void {
    ok(BootstrapImage.encode(a) == BootstrapImage.encode(b), label);
  }

  static function fails(action:Void->Void, expected:String):Void {
    var message = '';
    try action() catch (e:Dynamic) message = Std.string(e);
    ok(message.indexOf(expected) >= 0,
      'expected "' + expected + '", got "' + message + '"');
  }

  static function syntax(source:String):Value
    return SyntaxEncoder.program(new Parser(source).parse());

  static function runCompiled(bytecode:Value, expression:String):Array<Dynamic> {
    var vm = new ByteVm(1000000);
    vm.run(bytecode);
    return vm.runPlain(BytecodeCompiler.compileSource(expression));
  }

  static function verify(source:Value, name:String, body:String,
      contract:NType):Void {
    var rules = [{name:name,type:contract}];
    var host = ProceduralTransformer.generateHost(source, body, 'emitPlusTen', rules);
    var boot = ProceduralTransformer.generateBoot(source, body, 'emitPlusTen', rules);
    same(host, boot, 'Nail transformer output identical in AST and source-free VM');
    var expected = ProceduralTransformer.compile(source, host, rules);
    same(expected, BytecodeCompiler.compileSyntax(ProceduralTransformer.combine(source, host)),
      'independent reference compiler parity');
    var nail = new Vm(30000000);
    nail.loadStdlib();
    same(expected, nail.compileSyntaxWithNail(ProceduralTransformer.combine(source, host)),
      'Nail-written compiler parity');
    var sourceFree = new BootRuntime(30000000);
    same(expected, sourceFree.compileSyntax(ProceduralTransformer.combine(source, host)),
      'source-free compiler parity');
  }

  public static function main():Void {
    var generator = haxe.Resource.getString('procedural_transformer');
    ok(generator != null && generator.indexOf('def emitPlusTen') >= 0,
      'reusable external Nail generator file is bundled');

    var originalSource = 'def base = 32 ;';
    var original = syntax(originalSource);
    var before = BootstrapImage.encode(original);
    var rule = [{name:'plusTen',type:TFunction(TNumber,TNumber)}];

    var host = ProceduralTransformer.generateHost(original, generator, 'emitPlusTen', rule);
    var self = ProceduralTransformer.generateBoot(original, generator, 'emitPlusTen', rule);
    same(host, self, 'host/bootstrap procedural transformer parity');
    ok(BootstrapImage.encode(original) == before,
      'original first-class source Syntax remains immutable');
    var rewritten = BootstrapImage.encode(host);
    ok(rewritten.indexOf('#proc_gensym_0_x') >= 0,
      'generated binder renamed to deterministic private ID');
    ok(rewritten.indexOf('#proc_local_x') < 0,
      'no unexpanded local marker remains in accepted output');

    var combined = ProceduralTransformer.combine(original, host);
    var output = ProceduralTransformer.compile(original, host, rule);
    same(output, BytecodeCompiler.compileSyntax(combined), 'checked output compiler parity');
    var compiler = new Vm(30000000);
    compiler.loadStdlib();
    same(output, compiler.compileSyntaxWithNail(combined),
      'Nail compiler compiles procedural declarations identically');
    var bootstrap = new BootRuntime(30000000);
    same(output, bootstrap.compileSyntax(combined),
      'source-free Nail compiler compiles generated declarations identically');
    ok(Json.stringify(runCompiled(output, 'plusTen base ;')) == '[42]',
      'declaration generated by Nail runs and references source binding');
    bootstrap.runBytecode(output);
    ok(Json.stringify(bootstrap.runPlain('plusTen base ;')) == '[42]',
      'source-free runtime executes generated declaration');

    // A second public generator uses the Nail standard library's builder
    // functions directly. Its type checker sees those same stdlib signatures.
    var builderSource = haxe.Resource.getString('procedural_builder');
    ok(builderSource != null, 'Nail builder-based transformer resource available');
    var builderRules = [{name:'fromBuilder',type:TFunction(TNumber,TNumber)}];
    var builderHost = ProceduralTransformer.generateHost(original, builderSource,
      'emitIdentity', builderRules);
    var builderBoot = ProceduralTransformer.generateBoot(original, builderSource,
      'emitIdentity', builderRules);
    same(builderHost, builderBoot, 'stdlib builder generator host/bootstrap parity');
    ok(runCompiled(ProceduralTransformer.compile(original, builderHost, builderRules),
      'fromBuilder base ;')[0] == 32,
      'pure Nail Syntax builders generate an executable typed identity');

    // Source-order purity, generated local shadowing and explicit globals.
    var captureSource = syntax('def x = 40 ;');
    var capturing = StringTools.replace(generator,
      'syntaxLeaf " Var " " #proc_local_x "',
      'syntaxLeaf " Var " " x "');
    var captured = ProceduralTransformer.generateHost(captureSource, capturing,
      'emitPlusTen', rule);
    same(captured, ProceduralTransformer.generateBoot(captureSource, capturing,
      'emitPlusTen', rule), 'noncapturing caller variable preserved on both VMs');
    ok(Json.stringify(runCompiled(ProceduralTransformer.compile(captureSource, captured, rule),
      'plusTen 99 ;')) == '[50]',
      'generated local cannot capture caller global x = 40');

    // The low-level compile method is also guarded. Directly supplied
    // Syntax cannot bypass alpha-renaming simply by satisfying a type.
    var uncheckedMachine = new Vm(20000000);
    uncheckedMachine.loadStdlib();
    uncheckedMachine.run(generator);
    var raw = uncheckedMachine.invoke('emitPlusTen', original);
    fails(() -> ProceduralTransformer.compile(original, raw, rule),
      'generated lambda has no private binder');
    var duplicate = SyntaxEncoder.program([
      Define('a', Lambda('#proc_gensym_0_x', Var('#proc_gensym_0_x'))),
      Define('b', Lambda('#proc_gensym_0_x', Var('#proc_gensym_0_x')))
    ]);
    fails(() -> ProceduralHygiene.verifyPrepared(duplicate),
      'duplicate private binding');
    var freePrivate = SyntaxEncoder.program([
      Define('a', Lambda('#proc_gensym_0_x', Var('#proc_gensym_1_y')))
    ]);
    fails(() -> ProceduralHygiene.verifyPrepared(freePrivate),
      'unbound private identifier');

    // General declaration generation is not limited to one function.
    // Identical local marker spellings in different generated definitions
    // receive distinct private bindings in deterministic source order.
    var twoFunctions = SyntaxEncoder.program([
      Define('first', Lambda('#proc_local_x', Var('#proc_local_x'))),
      Define('second', Lambda('#proc_local_x', Var('#proc_local_x')))
    ]);
    var prepared = ProceduralHygiene.prepare(twoFunctions);
    var preparedImage = BootstrapImage.encode(prepared);
    ok(preparedImage.indexOf('#proc_gensym_0_x') >= 0 &&
      preparedImage.indexOf('#proc_gensym_1_x') >= 0,
      'separate generated declarations receive distinct lexical identifiers');
    ProceduralHygiene.verifyPrepared(prepared);
    var twoContracts = [
      {name:'first', type:TFunction(TNumber,TNumber)},
      {name:'second', type:TFunction(TNumber,TNumber)}
    ];
    ok(Json.stringify(runCompiled(
      ProceduralTransformer.compile(original, prepared, twoContracts),
      'first ( second base ) ;')) == '[32]',
      'multiple fresh typed declarations compile and execute in source order');

    var nested = SyntaxEncoder.program([
      Define('nested', Lambda('#proc_local_x',
        Lambda('#proc_local_x', Var('#proc_local_x'))))
    ]);
    var nestedPrepared = ProceduralHygiene.prepare(nested);
    var nestedImage = BootstrapImage.encode(nestedPrepared);
    ok(nestedImage.indexOf('#proc_gensym_0_x') >= 0 &&
      nestedImage.indexOf('#proc_gensym_1_x') >= 0,
      'nested lexical shadowing receives distinct private identities');

    // The compiler ABI still supports the exact numeric opt-in values.
    var exact = syntax('# nail: 0.29\ndef base = 32 ;');
    var exactGenerator = StringTools.replace(
      StringTools.replace(generator, 'syntaxLeaf " Var " " + "',
        'syntaxLeaf " Var " " #exact+ "'),
      'syntaxLeaf " Number " " 10 "',
      'syntaxLeaf " ExactNumber " " E:10/1 "');
    var exactRule = [{name:'plusTen',type:TFunction(TExact,TExact)}];
    var exactGenerated = ProceduralTransformer.generateHost(exact, exactGenerator,
      'emitPlusTen', exactRule);
    same(exactGenerated, ProceduralTransformer.generateBoot(exact, exactGenerator,
      'emitPlusTen', exactRule), 'exact generated syntax boot parity');
    var exactResults = runCompiled(
      ProceduralTransformer.compile(exact, exactGenerated, exactRule),
      '# nail: 0.29\nplusTen base ;');
    ok(exactResults.length == 1 && exactResults[0] == 'E:42/1',
      'procedural definition preserves exact numeric semantics');

    var site = SourcePositions.span(
      SourcePositions.scan('def x = 3 ;'), 0, 3);
    fails(() -> ProceduralTransformer.generateHost(original, generator,
      'emitPlusTen', [{name:'wrongName',type:TFunction(TNumber,TNumber)}], site),
      'Generated declaration at 1:1:');
    fails(() -> ProceduralTransformer.generateHost(original, generator,
      'emitPlusTen', [{name:'plusTen',type:TFunction(TBoolean,TBoolean)}]),
      'cannot unify');
    fails(() -> ProceduralTransformer.generateHost(original, generator,
      'emitPlusTen', []), 'definition count');

    var badBinder = StringTools.replace(generator,
      'syntaxLeaf " Name " " #proc_local_x "',
      'syntaxLeaf " Name " " x "');
    fails(() -> ProceduralTransformer.generateHost(original, badBinder,
      'emitPlusTen', rule), 'must use a proc-local binder');
    fails(() -> ProceduralTransformer.generateHost(original, badBinder,
      'emitPlusTen', rule, site), 'Procedural transformer at 1:1:');
    var unbound = StringTools.replace(generator,
      'syntaxLeaf " Var " " #proc_local_x "',
      'syntaxLeaf " Var " " #proc_local_missing "');
    fails(() -> ProceduralTransformer.generateHost(original, unbound,
      'emitPlusTen', rule), 'unbound local marker');
    fails(() -> ProceduralTransformer.generateBoot(original, unbound,
      'emitPlusTen', rule), 'unbound local marker');

    var wrongType = StringTools.replace(generator,
      'syntaxLeaf " Number " " 10 "',
      'syntaxLeaf " Bool " " true "');
    fails(() -> ProceduralTransformer.generateHost(original, wrongType,
      'emitPlusTen', rule), 'cannot unify');

    var invalidProgram = 'def emit p = if syntaxTag p == " Program " then '
      + 'syntaxLeaf " Text " " nope " else syntaxLeaf " Text " " nope " ;';
    fails(() -> ProceduralTransformer.generateHost(original, invalidProgram,
      'emit', rule), 'expected Program');
    fails(() -> ProceduralTransformer.generateBoot(original, invalidProgram,
      'emit', rule), 'expected Program');

    fails(() -> ProceduralTransformer.generateHost(original, 'def emit p = p ;',
      'emit', rule), 'must have signature Syntax -> Syntax');
    fails(() -> ProceduralTransformer.generateHost(original, generator,
      'missing', rule), 'unknown name');
    fails(() -> ProceduralTransformer.generateHost(original, generator,
      '#private', rule), 'invalid entry name');

    // Generated expressions with eager evaluation are refused: the new
    // declaration contract cannot smuggle side-effecting top-level forms.
    fails(() -> ProceduralHygiene.prepare(syntax('2 ;')),
      'only fresh definitions');

    // Deterministic output: fresh names and bytecode are the same across
    // independent calls, targets and source-free bootstrap sessions.
    same(host, ProceduralTransformer.generateHost(original, generator,
      'emitPlusTen', rule), 'fresh names are reproducible');
    verify(original, 'plusTen', generator, TFunction(TNumber,TNumber));

    trace('NailSeed v0.30 typed procedural transformers: ' + checks + ' passed');
  }
}
