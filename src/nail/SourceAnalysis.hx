package nail;

import nail.Ast.Expr;
import nail.Ast.Form;
import nail.BindingAnalysis.BindingIdentity;
import nail.SourcePositions.SourceSpan;
import nail.SourcePositions.SourceToken;

/** One diagnostic for an analysis pass; span is null when no trustworthy
    original-source range is available (for example, an import resolver error).
    Offsets use the existing SourcePositions conventions. */
typedef AnalysisDiagnostic = {
  var phase:String;
  var message:String;
  var span:Null<SourceSpan>;
}

/** A source declaration or lexical parameter, not a generated runtime name. */
typedef AnalysisSymbol = {
  var id:Int;
  var name:String;
  var kind:String;
  var span:Null<SourceSpan>;
  var signature:Null<String>;
}

typedef AnalysisReference = {
  var name:String;
  var targetId:Null<Int>;
  var span:SourceSpan;
}

typedef AnalysisEvaluation = {
  var type:String;
  var span:Null<SourceSpan>;
}

typedef AnalysisResult = {
  var ok:Bool;
  var version:Null<String>;
  var diagnostics:Array<AnalysisDiagnostic>;
  var symbols:Array<AnalysisSymbol>;
  var references:Array<AnalysisReference>;
  var evaluations:Array<AnalysisEvaluation>;
}

/** Read-only, request-scoped source analysis, independent of any editor.
    The source parser owns original coordinates, BindingAnalysis owns lexical
    identities, and TypeChecker owns type inference. This API does not run a
    Nail program or change the persistent compiler/bootstrap image.

    No synthetic macro positions or type-error token positions are invented.
    The type checker reports the enclosing original form when it fails. */
class SourceAnalysis {
  static function tokenSpan(token:SourceToken):SourceSpan
    return {start:token.start, end:token.end, line:token.line,
      column:token.column, endLine:token.endLine, endColumn:token.endColumn};

  static function atEnd(source:String):SourceSpan {
    var lines = source.split('\n');
    var line = lines.length;
    var column = lines[line - 1].length + 1;
    return {start:source.length, end:source.length, line:line, column:column,
      endLine:line, endColumn:column};
  }

  /** The existing parser numbers tokens *after* consuming the unexpected
      item. EOF insertions are zero-width, never attributed to a prior form. */
  static function parseErrorSpan(source:String, tokens:Array<SourceToken>,
      error:String):Null<SourceSpan> {
    var tokenIndex = ~/at token ([0-9]+)/;
    if (!tokenIndex.match(error)) {
      if (StringTools.startsWith(error, 'Unsupported Nail language version') &&
          tokens.length > 1 && tokens[0].text == 'nail')
        return tokenSpan(tokens[1]);
      return null;
    }
    var number = Std.parseInt(tokenIndex.matched(1));
    if (number == null) return null;
    if (number >= tokens.length) return atEnd(source);
    return tokenSpan(tokens[number <= 0 ? 0 : number - 1]);
  }

  static function symbolSpan(identity:BindingIdentity,
      tokens:Array<SourceToken>):Null<SourceSpan> {
    var area = identity.source;
    if (area == null) return null;
    // The BindingAnalysis span for a declaration covers its body, while a
    // parameter span may cover the lambda body. Locate the actual name token.
    // If it was generated by lowering, do not fabricate source coordinates.
    for (token in tokens)
      if (token.start >= area.start && token.end <= area.end &&
          token.text == identity.name)
        return tokenSpan(token);
    return null;
  }

  static function references(forms:Array<Form>, bindings:BindingAnalysis,
      provenance:SourceProvenance):Array<AnalysisReference> {
    var results:Array<AnalysisReference> = [];
    for (form in forms) {
      var root:Null<Expr> = switch (form) {
        case Define(_, body) | Evaluate(body): body;
        case _: null;
      };
      if (root == null) continue;
      var pending:Array<Expr> = [root];
      while (pending.length > 0) {
        var expr = pending.pop();
        switch (expr) {
        case Var(name):
          // Native primitives and generated identifiers remain an internal
          // implementation detail; surface references have original spans.
          if (StringTools.startsWith(name, '#')) continue;
          var span = provenance.spanOfExpression(expr);
          if (span == null) continue;
          var binding = bindings.bindingForVariable(expr);
          results.push({name:name, targetId:binding == null ? null : binding.id, span:span});
        case Apply(fn, arg):
          pending.push(arg);
          pending.push(fn);
        case Lambda(_, body): pending.push(body);
        case If(condition, yes, no):
          pending.push(no);
          pending.push(yes);
          pending.push(condition);
        case Literal(_):
        }
      }
    }
    results.sort((a, b) -> a.span.start == b.span.start
      ? Reflect.compare(a.name, b.name) : a.span.start - b.span.start);
    return results;
  }

  public static function analyze(source:String,
      ?modules:String->Null<String>, ?syntaxExperiment:Bool=false,
      ?environment:TypeChecker):AnalysisResult {
    var report:AnalysisResult = {ok:false, version:null, diagnostics:[],
      symbols:[], references:[], evaluations:[]};
    var parser:Parser;
    var checker=environment==null ? new TypeChecker() : environment.copy();
    try parser = syntaxExperiment ? checker.experimentalParser(source) : new Parser(source)
    catch (error:Dynamic) {
      var message = Std.string(error);
      var tokens:Array<SourceToken> = [];
      try { tokens = SourcePositions.scan(source); } catch (_:Dynamic) {}
      report.diagnostics.push({phase:'parse', message:message,
        span:parseErrorSpan(source, tokens, message)});
      return report;
    }
    report.version = parser.languageVersion;

    var forms:Array<Form>;
    try forms = parser.parse(modules)
    catch (error:Dynamic) {
      var message = Std.string(error);
      report.diagnostics.push({phase:'parse', message:message,
        span:parseErrorSpan(source, parser.tokenPositions, message)});
      return report;
    }

    var bindings = BindingAnalysis.resolve(forms, parser.provenance);
    for (symbol in bindings.symbols) {
      // Do not expose macro hygiene internals as user-defined declarations.
      if (StringTools.startsWith(symbol.name, '#')) continue;
      report.symbols.push({id:symbol.id, name:symbol.name, kind:symbol.kind,
        span:symbolSpan(symbol, parser.tokenPositions), signature:null});
    }
    report.references = references(forms, bindings, parser.provenance);

    var inferred:Array<String>;
    try inferred = checker.checkParsed(parser, forms)
    catch (error:Dynamic) {
      report.diagnostics.push({phase:'type', message:Std.string(error),
        span:checker.lastFailureSpan});
      return report;
    }

    for (symbol in report.symbols)
      if (symbol.kind == 'definition') symbol.signature = checker.signature(symbol.name);

    var evaluationIndex = 0;
    for (form in forms) switch (form) {
      case Evaluate(_):
        if (evaluationIndex >= inferred.length)
          throw 'Analysis invariant: fewer inferred evaluation types than forms';
        report.evaluations.push({type:inferred[evaluationIndex++],
          span:parser.provenance.spanOfForm(form)});
      case _:
    }
    if (evaluationIndex != inferred.length)
      throw 'Analysis invariant: more inferred evaluation types than forms';
    report.ok = true;
    return report;
  }
}
