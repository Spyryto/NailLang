package nail;

import haxe.ds.ObjectMap;
import nail.Ast.Expr;
import nail.Ast.Form;
import nail.SourcePositions.SourceSpan;
import nail.SourcePositions.SourceToken;

/** A source span together with the logical source identity that owns it. */
typedef SourceOrigin = {
  final sourceId:String;
  final span:SourceSpan;
}

/** An optional source map for parser-created AST nodes, kept outside Ast.Expr
    and the canonical Syntax/bytecode format. No host object references escape
    into Nail runtime values. Parser transformations may create synthetic nodes:
    their outer expression retains the source range of the lowered construct. */
class SourceProvenance {
  public final tokens:Array<SourceToken>;
  public var sourceId:String;
  final expressionSpans:ObjectMap<Dynamic, SourceSpan> = new ObjectMap();
  final formSpans:ObjectMap<Dynamic, SourceSpan> = new ObjectMap();
  final expansionSites:ObjectMap<Dynamic, SourceSpan> = new ObjectMap();
  final templateOrigins:ObjectMap<Dynamic, SourceOrigin> = new ObjectMap();
  final expressionStarts:ObjectMap<Dynamic, Int> = new ObjectMap();

  public function new(tokens:Array<SourceToken>, sourceId:String = '<source>') {
    this.tokens = tokens;
    this.sourceId = sourceId;
  }

  public function expression(expr:Expr, first:Int, afterLast:Int):Expr {
    var source = SourcePositions.span(tokens, first, afterLast);
    if (source != null) {
      expressionSpans.set(expr, source);
      expressionStarts.set(expr, first);
    }
    return expr;
  }

  public function form(form:Form, first:Int, afterLast:Int):Form {
    var source = SourcePositions.span(tokens, first, afterLast);
    if (source != null) formSpans.set(form, source);
    return form;
  }

  /** Exact `expand` keyword in an original invocation, or the inherited
      outer call when another macro invocation was itself generated by a
      template. No source text is re-parsed or matched by message. */
  public function invocationSite(expr:Expr, inherited:Null<SourceSpan>):Null<SourceSpan> {
    if (inherited != null) return inherited;
    var first = startToken(expr);
    if (first < 0 || first >= tokens.length || tokens[first].text != 'expand')
      return null;
    return SourcePositions.span(tokens, first, first + 1);
  }

  /** Record a generated node's two independent origins: its expansion call
      and the source expression within the macro's quoted template.
      Neither changes the core AST or the serialized Syntax representation. */
  public function generated(expr:Expr, template:Expr,
      site:Null<SourceSpan>, ?templateProvenance:SourceProvenance):Expr {
    if (site != null) expansionSites.set(expr, site);
    // Each macro definition owns its source context; the caller does not.
    // A foreign template span must never be interpreted against this.tokens.
    var origin = templateProvenance == null ? this : templateProvenance;
    var declared = origin.spanOfExpression(template);
    if (declared != null)
      templateOrigins.set(expr,{sourceId:origin.sourceId,
        span:origin.templateCore(declared)});
    else {
      var inherited = templateOrigins.get(template);
      if (inherited != null) templateOrigins.set(expr,inherited);
    }
    return expr;
  }

  /** Parenthesized quote arguments are source wrappers, not part of the
      actual macro template. Keep the original token identities and remove
      only complete, balanced outer pairs. */
  function templateCore(span:SourceSpan):SourceSpan {
    var first = -1;
    var last = -1;
    for (i in 0...tokens.length) {
      if (tokens[i].start == span.start) first = i;
      if (tokens[i].end == span.end) last = i;
    }
    if (first < 0 || last < first) return span;
    while (last > first + 1 && tokens[first].text == '('
        && tokens[last].text == ')') {
      var depth = 0;
      var closesAtLast = true;
      for (i in first...last + 1) {
        if (tokens[i].text == '(') depth++;
        if (tokens[i].text == ')') depth--;
        if (depth == 0 && i < last) closesAtLast = false;
        if (depth < 0) closesAtLast = false;
      }
      if (!closesAtLast || depth != 0) break;
      first++;
      last--;
    }
    var core = SourcePositions.span(tokens,first,last + 1);
    return core == null ? span : core;
  }

  /** The owner is explicit, even when a nested macro was imported through
      another module. Module identifiers are logical names, not fabricated paths. */
  public function templateOriginOfExpression(expr:Expr):Null<SourceOrigin>
    return templateOrigins.get(expr);

  /** Legacy same-file span for local macros only. */
  public function templateOfExpression(expr:Expr):Null<SourceSpan> {
    var found = templateOrigins.get(expr);
    return found == null || found.sourceId != sourceId ? null : found.span;
  }

  /** Carry call-site provenance to a normalized form. Generated children
      have no invented locations; their source-origin arguments keep their own. */
  public function transfer(original:Form, normalized:Form):Void {
    var span = spanOfForm(original);
    if (span != null) formSpans.set(normalized, span);
    switch ([original, normalized]) {
      case [Define(_, before), Define(_, after)] | [Evaluate(before), Evaluate(after)]:
        var bodySpan = spanOfExpression(before);
        if (bodySpan != null) {
          expansionSites.set(after, bodySpan);
          // A macro may return a caller argument unchanged. Preserve that
          // argument's more precise original span rather than overwriting it.
          if (expressionSpans.get(after) == null) expressionSpans.set(after, bodySpan);
        }
        var first = expressionStarts.get(before);
        if (first != null && expressionStarts.get(after) == null)
          expressionStarts.set(after, first);
      case _:
    }
  }

  public function startToken(expr:Expr):Int {
    var position = expressionStarts.get(expr);
    return position == null ? -1 : position;
  }

  public function spanOfExpression(expr:Expr):Null<SourceSpan>
    return expressionSpans.get(expr);

  /** Outer macro call site, even if the result reuses a caller argument. */
  public function expansionSiteOfExpression(expr:Expr):Null<SourceSpan>
    return expansionSites.get(expr);

  public function spanOfForm(form:Form):Null<SourceSpan>
    return formSpans.get(form);
}
